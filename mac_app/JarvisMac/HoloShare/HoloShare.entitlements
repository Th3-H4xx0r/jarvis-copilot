<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- App extensions must be sandboxed. Nothing here needs a provisioning profile. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- jc-client's loopback proxy (127.0.0.1) and the LAN receivers of his other devices. -->
	<key>com.apple.security.network.client</key>
	<true/>
	<key>com.apple.security.files.user-selected.read-only</key>
	<true/>
	<!-- Where the Jarvis app writes the proxy's address (HoloDrop.shareInfoPath). -->
	<key>com.apple.security.temporary-exception.files.home-relative-path.read-only</key>
	<array>
		<string>/.jarviscopilot-client/holo-share.json</string>
	</array>
</dict>
</plist>
