<Project Sdk="Microsoft.NET.Sdk">
  <!-- No UI, no WinRT: every pure rule lives here and is tested on any OS. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Jarvis.Core</RootNamespace>
    <!-- The glasses camera's frame file is shared memory (GlassesCamFrameFile). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Jarvis.Tests" />
  </ItemGroup>
</Project>
