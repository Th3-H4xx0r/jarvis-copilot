<Project Sdk="Microsoft.NET.Sdk">
  <!-- No UI, no WinRT: every pure rule lives here and is tested on any OS. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Jarvis.Core</RootNamespace>
    <!-- The glasses camera's frame file is shared memory (GlassesCamFrameFile). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Jarvis.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- Private: only the app (and the tests) draw the pair QR, so they reference it themselves and
         the updater and the camera pieces don't carry it. -->
    <PackageReference Include="Net.Codecrete.QrCodeGenerator" PrivateAssets="all" />
  </ItemGroup>
</Project>
