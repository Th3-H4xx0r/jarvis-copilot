<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.22621.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>Jarvis</AssemblyName>
    <ApplicationIcon>jarvis.ico</ApplicationIcon>
    <Product>Jarvis</Product>
    <RootNamespace>Jarvis</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="H.NotifyIcon.Wpf" />
    <PackageReference Include="NAudio" />
    <PackageReference Include="Microsoft.Web.WebView2" />
    <PackageReference Include="System.Speech" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" />
    <PackageReference Include="SIPSorcery" />
    <PackageReference Include="SIPSorceryMedia.Encoders" />
  </ItemGroup>
  <ItemGroup>
    <None Include="Assets\wakeword\*.onnx" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Assets\wakeword\SHA256SUMS;Assets\wakeword\LICENSE-models.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Jarvis.Core\Jarvis.Core.csproj" />
  </ItemGroup>
</Project>
