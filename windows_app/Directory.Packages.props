<Project>
  <!-- Every package pinned [floor, next_major) (AGENTS.md dependency policy). -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.Web.WebView2" Version="[1.0.4314.35, 2.0.0)" />
    <!-- 2.4.x ships only net10.0-windows + net462 libs; 2.3.2 is the newest with a net8.0-windows lib. -->
    <PackageVersion Include="H.NotifyIcon.Wpf" Version="[2.3.2, 3.0.0)" />
    <PackageVersion Include="NAudio" Version="[2.2.1, 3.0.0)" />
    <PackageVersion Include="Microsoft.ML.OnnxRuntime" Version="[1.32.0, 2.0.0)" />
    <PackageVersion Include="System.Speech" Version="[8.0.0, 9.0.0)" />
    <PackageVersion Include="SIPSorcery" Version="[10.0.17, 11.0.0)" />
    <PackageVersion Include="SIPSorceryMedia.Encoders" Version="[10.0.4, 11.0.0)" />
    <!-- PC Stats helper service (JarvisSensors): sensors through PawnIO, frame timing through ETW. -->
    <PackageVersion Include="LibreHardwareMonitorLib" Version="[0.9.6, 1.0.0)" />
    <PackageVersion Include="Microsoft.Diagnostics.Tracing.TraceEvent" Version="[3.2.8, 4.0.0)" />
    <PackageVersion Include="xunit" Version="[2.9.3, 3.0.0)" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="[3.1.5, 4.0.0)" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="[18.12.0, 19.0.0)" />
  </ItemGroup>
</Project>
