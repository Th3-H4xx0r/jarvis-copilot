<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>JarvisCopilot</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>jarviscopilot_mobile</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.jarviscopilot.mobile</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>jarviscopilot</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>twitter</string>
		<string>instagram</string>
		<string>fb</string>
		<string>fb-messenger</string>
		<string>whatsapp</string>
		<string>tg</string>
		<string>sgnl</string>
		<string>slack</string>
		<string>spotify</string>
		<string>youtube</string>
		<string>maps</string>
		<string>comgooglemaps</string>
		<string>googlegmail</string>
		<string>googlechrome</string>
		<string>calshow</string>
		<string>mobilenotes</string>
		<string>x-apple-reminderkit</string>
		<string>shortcuts</string>
		<string>uber</string>
		<string>lyft</string>
		<string>github</string>
		<string>discord</string>
		<string>zoomus</string>
	</array>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>Used so JarvisCopilot can read and write calendar events you ask for.</string>
	<key>NSCalendarsUsageDescription</key>
	<string>Used so JarvisCopilot can add or read calendar events you ask for.</string>
	<key>NSCalendarsWriteOnlyAccessUsageDescription</key>
	<string>Used so JarvisCopilot can add calendar events you ask for.</string>
	<key>NSCameraUsageDescription</key>
	<string>Used to scan pair QR codes and capture photos requested by your JarvisCopilot.</string>
	<key>NSContactsUsageDescription</key>
	<string>Used so JarvisCopilot can search your contacts when you ask.</string>
	<key>NSHealthShareUsageDescription</key>
	<string>Used so JarvisCopilot can report on activity / heart rate when you ask.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>With "Always" access, JarvisCopilot records your location history (about every 10 minutes) so you can ask where you've been, and stays connected in the background so it can run tasks you request.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Used to answer "where am I?" and to provide location to skills you invoke.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Used to record voice messages and live audio sent to JarvisCopilot.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Used so JarvisCopilot can pick or attach photos at your request.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Used for the local voice-to-text fallback when the server is unreachable.</string>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>UIWindowScene</string>
					<key>UISceneConfigurationName</key>
					<string>Default Configuration</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
		<string>fetch</string>
		<string>audio</string>
		<string>location</string>
	</array>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<false/>
</dict>
</plist>
