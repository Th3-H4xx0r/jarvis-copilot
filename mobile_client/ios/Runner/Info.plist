<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>$(DEVELOPMENT_LANGUAGE)</string>
    <key>CFBundleDisplayName</key>
    <string>JarvisCopilot</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>jarviscopilot_mobile</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>$(FLUTTER_BUILD_NAME)</string>
    <key>CFBundleSignature</key>
    <string>????</string>
    <key>CFBundleVersion</key>
    <string>$(FLUTTER_BUILD_NUMBER)</string>
    <key>LSRequiresIPhoneOS</key>
    <true/>
    <key>UILaunchStoryboardName</key>
    <string>LaunchScreen</string>
    <key>UIMainStoryboardFile</key>
    <string>Main</string>
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
    </array>
    <key>UIViewControllerBasedStatusBarAppearance</key>
    <false/>

    <!-- URL scheme for the pairing deep-link generated by the webui's
         "+ Pair new device" QR code. The native code routes to PairPage
         and pre-fills server + code. -->
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLName</key>
            <string>com.jarviscopilot.mobile</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>jarviscopilot</string>
            </array>
        </dict>
    </array>

    <!-- Background modes: silent push wakes the app, audio enables
         a paused-but-not-killed voice page during a call. fetch keeps
         the WS-bridge reconnection logic alive briefly. (We do NOT
         declare `processing` because we don't schedule any
         BGProcessingTasks — leaving it in is dead weight.) -->
    <key>UIBackgroundModes</key>
    <array>
        <string>remote-notification</string>
        <string>fetch</string>
        <string>audio</string>
        <!-- location: opt-in background location history + keeps the device
             bridge connected so server skills don't time out while
             backgrounded. Only active when the user enables tracking. -->
        <string>location</string>
    </array>

    <!-- LSApplicationQueriesSchemes — iOS sandbox blocks
         canOpenURL() from returning true for schemes not declared
         here. Keep this list in sync with AppOpenBridge.knownApps. -->
    <key>LSApplicationQueriesSchemes</key>
    <array>
        <string>twitter</string>
        <string>instagram</string>
        <string>fb</string>
        <string>fb-messenger</string>
        <string>whatsapp</string>
        <string>tg</string>
        <string>sgnl</string>
        <string>slack</string>
        <string>spotify</string>
        <string>youtube</string>
        <string>maps</string>
        <string>comgooglemaps</string>
        <string>googlegmail</string>
        <string>googlechrome</string>
        <string>calshow</string>
        <string>mobilenotes</string>
        <string>x-apple-reminderkit</string>
        <string>shortcuts</string>
        <string>uber</string>
        <string>lyft</string>
        <string>github</string>
        <string>discord</string>
        <string>zoomus</string>
    </array>

    <!-- Permission usage strings — required for the corresponding
         iOS APIs even when triggered indirectly via plugins. -->
    <key>NSCameraUsageDescription</key>
    <string>Used to scan pair QR codes and capture photos requested by your JarvisCopilot.</string>
    <key>NSMicrophoneUsageDescription</key>
    <string>Used to record voice messages and live audio sent to JarvisCopilot.</string>
    <key>NSLocationWhenInUseUsageDescription</key>
    <string>Used to answer "where am I?" and to provide location to skills you invoke.</string>
    <key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
    <string>With "Always" access, JarvisCopilot records your location history (about every 10 minutes) so you can ask where you've been, and stays connected in the background so it can run tasks you request.</string>
    <key>NSPhotoLibraryUsageDescription</key>
    <string>Used so JarvisCopilot can pick or attach photos at your request.</string>
    <key>NSContactsUsageDescription</key>
    <string>Used so JarvisCopilot can search your contacts when you ask.</string>
    <key>NSCalendarsUsageDescription</key>
    <string>Used so JarvisCopilot can add or read calendar events you ask for.</string>
    <!-- iOS 17+ split the calendar permission into read/write variants;
         declare both alongside the legacy key so the API surface works
         across major versions. -->
    <key>NSCalendarsFullAccessUsageDescription</key>
    <string>Used so JarvisCopilot can read and write calendar events you ask for.</string>
    <key>NSCalendarsWriteOnlyAccessUsageDescription</key>
    <string>Used so JarvisCopilot can add calendar events you ask for.</string>
    <key>NSHealthShareUsageDescription</key>
    <string>Used so JarvisCopilot can report on activity / heart rate when you ask.</string>
    <key>NSSpeechRecognitionUsageDescription</key>
    <string>Used for the local voice-to-text fallback when the server is unreachable.</string>
    <!-- record_audio reuses the mic permission (NSMicrophoneUsageDescription
         declared above). No separate key needed. -->
    <!-- send_sms (iOS) opens MFMessageComposeViewController — no
         additional usage-description key required; the SMS sheet
         handles its own permission UI. -->

    <!-- Scene lifecycle. iOS 13+ uses UIScene; we explicitly point the
         default scene at our SceneDelegate so bridge wiring runs.
         Without this, FlutterAppDelegate.window stays nil and the
         platform channels never bind. -->
    <key>UIApplicationSceneManifest</key>
    <dict>
        <key>UIApplicationSupportsMultipleScenes</key>
        <false/>
        <key>UISceneConfigurations</key>
        <dict>
            <key>UIWindowSceneSessionRoleApplication</key>
            <array>
                <dict>
                    <key>UISceneClassName</key>
                    <string>UIWindowScene</string>
                    <key>UISceneConfigurationName</key>
                    <string>Default Configuration</string>
                    <key>UISceneDelegateClassName</key>
                    <string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
                </dict>
            </array>
        </dict>
    </dict>

    <!-- ATS — we pin certificates ourselves; permit arbitrary loads but
         keep TLS required. -->
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsArbitraryLoads</key>
        <true/>
    </dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
</dict>
</plist>
