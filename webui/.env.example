# JarvisCopilot Web UI -- local machine config template
# Copy this to .env and fill in your values.
# start.sh sources .env automatically if present.
# All values are optional -- auto-discovery will fill in anything left blank.

# Path to your jarviscopilot checkout (the repo that contains run_agent.py)
# HERMES_WEBUI_AGENT_DIR=/path/to/jarviscopilot

# Python executable to use (defaults to the agent venv if found)
# HERMES_WEBUI_PYTHON=/path/to/python

# Bind address (default: 127.0.0.1 -- loopback only, safe default)
# HERMES_WEBUI_HOST=127.0.0.1

# Port to listen on (default: 8787)
# HERMES_WEBUI_PORT=8787

# Where to store sessions, workspaces, and other state (default: ~/.jarviscopilot/webui)
# HERMES_WEBUI_STATE_DIR=~/.jarviscopilot/webui

# Default workspace directory shown on first launch
# HERMES_WEBUI_DEFAULT_WORKSPACE=~/workspace

# Optional model override. Leave unset to use the active JarvisCopilot provider default.
# HERMES_WEBUI_DEFAULT_MODEL=

# Base directory for all JarvisCopilot state (affects all paths above if set)
# HERMES_HOME=~/.jarviscopilot

# Path to your JarvisCopilot config.yaml (for toolsets and model config)
# HERMES_CONFIG_PATH=~/.jarviscopilot/config.yaml

# Display name for the assistant in the UI (default: JarvisCopilot)
# HERMES_WEBUI_BOT_NAME=JarvisCopilot
