// SF Symbol name → LVGL built-in glyph. The ONE list: jarvis_logic validates names
// against it and the page renderer draws from it. X-macro: SYM(sf_name, LV_SYMBOL suffix).
SYM("wifi", WIFI)
SYM("battery.100", BATTERY_FULL)
SYM("battery.75", BATTERY_3)
SYM("battery.50", BATTERY_2)
SYM("battery.25", BATTERY_1)
SYM("battery.0", BATTERY_EMPTY)
SYM("bolt.fill", CHARGE)
SYM("house.fill", HOME)
SYM("gearshape.fill", SETTINGS)
SYM("bell.fill", BELL)
SYM("play.fill", PLAY)
SYM("pause.fill", PAUSE)
SYM("stop.fill", STOP)
SYM("forward.fill", NEXT)
SYM("backward.fill", PREV)
SYM("speaker.wave.2.fill", VOLUME_MAX)
SYM("speaker.wave.1.fill", VOLUME_MID)
SYM("speaker.slash.fill", MUTE)
SYM("music.note", AUDIO)
SYM("photo", IMAGE)
SYM("video.fill", VIDEO)
SYM("location.fill", GPS)
SYM("mappin", GPS)
SYM("phone.fill", CALL)
SYM("envelope.fill", ENVELOPE)
SYM("trash.fill", TRASH)
SYM("pencil", EDIT)
SYM("eye.fill", EYE_OPEN)
SYM("eye.slash.fill", EYE_CLOSE)
SYM("exclamationmark.triangle.fill", WARNING)
SYM("plus", PLUS)
SYM("minus", MINUS)
SYM("checkmark", OK)
SYM("xmark", CLOSE)
SYM("arrow.clockwise", REFRESH)
SYM("arrow.up", UP)
SYM("arrow.down", DOWN)
SYM("chevron.left", LEFT)
SYM("chevron.right", RIGHT)
SYM("power", POWER)
SYM("list.bullet", LIST)
SYM("line.3.horizontal", BARS)
SYM("folder.fill", DIRECTORY)
SYM("doc.fill", FILE)
SYM("square.and.arrow.down", DOWNLOAD)
SYM("square.and.arrow.up", UPLOAD)
SYM("repeat", LOOP)
SYM("shuffle", SHUFFLE)
SYM("keyboard", KEYBOARD)
SYM("drop.fill", TINT)
SYM("sdcard", SD_CARD)
SYM("circle.fill", BULLET)
