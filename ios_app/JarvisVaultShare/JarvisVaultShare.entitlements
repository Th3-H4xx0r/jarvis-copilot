<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The App Group doubles as the Keychain access group VaultShareKeychain reads:
	     the paired server and the vault's folder names, written by the app. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.jarviscopilot.jarviscopilotMobileAndIOS</string>
	</array>
</dict>
</plist>
